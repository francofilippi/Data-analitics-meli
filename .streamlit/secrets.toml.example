# ESTE ARCHIVO NO VA AL REPO (.gitignore ya lo excluye).
# Es solo un template que muestra qué secrets hay que cargar en:
#   Streamlit Cloud → App settings → Secrets
#   Railway         → Variables
#
# Cuando conectemos la API real de Mercado Libre, cargá estos valores
# en el panel de secrets de Streamlit (NO los pegues en el codigo).

[mercadolibre]
client_id     = "TU_ML_CLIENT_ID"
client_secret = "TU_ML_CLIENT_SECRET"
# Los access tokens por cliente van en la DB, no aca.
