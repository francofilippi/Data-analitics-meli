# Template de secrets para Streamlit Cloud.
# Pegá el contenido en: App settings → Secrets
# NUNCA commitees el secrets.toml real (ya está en .gitignore).

# ------------------------------------------------------------------ #
# Tokens de acceso al dashboard (generados con scripts/generar_tokens.py)
# ------------------------------------------------------------------ #
[tokens]
admin        = "REEMPLAZAR_con_generar_tokens.py"
tienda_norte = "REEMPLAZAR_con_generar_tokens.py"
deco_hogar   = "REEMPLAZAR_con_generar_tokens.py"
tech_outlet  = "REEMPLAZAR_con_generar_tokens.py"

# ------------------------------------------------------------------ #
# Credenciales ML por cliente
# El nombre de sección [ml_{nombre}] debe coincidir con el cliente_ml
# que ves en el selector del dashboard.
# ------------------------------------------------------------------ #

# [ml_{nombre_del_seller}]
# client_id     = "APP_ID de developers.mercadolibre.com.ar"
# client_secret = "SECRET_KEY de tu app ML"
# access_token  = "APP_USR-..."   # expira en 6 horas, se refresca solo
# refresh_token = "TG-..."        # expira en 6 meses; actualizarlo con
#                                 #   scripts/refresh_tokens.py cuando caduque
# seller_id     = "123456789"     # ID numérico del usuario vendedor en ML

[ml_tienda_norte]
client_id     = ""
client_secret = ""
access_token  = ""
refresh_token = ""
# seller_id es opcional — si no lo ponés, la app lo obtiene sola de /users/me

[ml_deco_hogar]
client_id     = ""
client_secret = ""
access_token  = ""
refresh_token = ""
